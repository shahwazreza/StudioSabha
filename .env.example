# --- Supabase (database, auth, image storage) ---
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings > API > service_role key (server-only, NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- Square (checkout / payments) ---
# Square Developer Dashboard: https://developer.squareup.com/apps
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# "sandbox" while testing, "production" when live
SQUARE_ENVIRONMENT=sandbox
# Square Developer Dashboard > Webhooks > Signature key
SQUARE_WEBHOOK_SIGNATURE_KEY=

# --- Resend (contact/commission form emails) ---
# https://resend.com — free tier is plenty to start
RESEND_API_KEY=
# Where contact form submissions get sent
ARTIST_NOTIFY_EMAIL=
# Verified sending address in Resend (can be onboarding@resend.dev while testing)
RESEND_FROM_EMAIL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secret admin address ---
# The studio admin lives at https://<site>/<ADMIN_PATH> (12+ letters, numbers,
# - or _). /admin shows "not found". Keep it private: set it here and in the
# hosting settings only, never in the code.
ADMIN_PATH=
