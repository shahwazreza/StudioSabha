@startuml use-cases
!pragma layout smetana
!include _style.iuml
left to right direction
title StudioSabha: Use Cases

actor "Visitor / Buyer" as V
actor "Artist (admin)" as A
actor "Square" as SQ
actor "Resend" as RS

rectangle "Public website" {
  usecase "Browse homepage\n(slideshow, highlights, banners)" as U1
  usecase "Browse & filter shop\n(all / originals / prints / on sale)" as U2
  usecase "View artwork\n(photos, wall photo, sizes, sale price)" as U3
  usecase "View on your wall (AR)" as U4
  usecase "Buy now" as U5
  usecase "Ask about a piece /\nrequest a commission" as U6
  usecase "Read About + portfolio" as U7
}

rectangle "Studio admin" {
  usecase "Sign in" as A0
  usecase "Add / edit / delete artwork\n(photos, sizes, sale, NEW, slideshow)" as A1
  usecase "Create wall photo" as A2
  usecase "Manage announcements" as A3
  usecase "Edit About section" as A4
  usecase "Read / reply / delete inquiries" as A5
  usecase "View orders" as A6
}

V --> U1
V --> U2
V --> U3
V --> U4
V --> U5
V --> U6
V --> U7
U3 ..> U4 : <<extend>>
U3 ..> U5 : <<extend>>
U5 --> SQ
U6 --> RS

A --> A0
A --> A1
A --> A2
A --> A3
A --> A4
A --> A5
A --> A6
A1 ..> A0 : <<include>>
A2 ..> A1 : <<extend>>
@enduml
